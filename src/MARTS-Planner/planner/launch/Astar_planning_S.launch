<?xml version="1.0" encoding="utf-8"?>
<launch>

   <arg name="odom_topic" value="odom" />
   <arg name="enable_rviz" default="true" />
   <node if="$(arg enable_rviz)" name="rviz" pkg="rviz" type="rviz" output="screen"
    args="-d $(find gcopter)/config/Astar_planning.rviz"> 
  </node>

<arg name="map_size_x" default="25.0"/>   
<arg name="map_size_y" default="25.0"/>
<arg name="map_size_z" default="2.0"/>

<!-- ID0: Init Map -->
<arg name="search_x_max" default="12.0"/>   
<arg name="search_x_min" default="-12.0"/>
<arg name="search_y_max" default="4.0"/>
<arg name="search_y_min" default="-3.0"/>   
<arg name="search_z_max" default="1.2"/>
<arg name="search_z_min" default="0.0"/>

<arg name="cloud_resolution"    default=" 0.2"/>

<arg name="map_id"              default=" 0"        />
<arg name="isExp"               default=" false"    />
<arg name="isReplanMode"        default=" false"    />
<arg name="isNarrowSlitMode"    default=" false"     />
<arg name="time_ahead"          default=" 0.300"    />
<!-- map in file -->
<arg name="pcd_path"            default="$(find grid_path_searcher)/pcd/map_init_4.pcd"/>

<!-- random map -->
<arg name="random_num"          default=" 50"/>

<!-- Astar param -->
<arg name="distance"            default="euclidean"/> <!--　euclidean  manhattan-->
<arg name="weight_a"            default=" 1.0"/>      
<arg name="weight_b"            default=" 1.0"/>
<arg name="weight_angle"        default=" 1.0"/> <!-- Jn: nominal configuration -->
<arg name="weight_clearance"    default=" 2.0"/> <!-- Jc: obstacle clearance -->
<arg name="weight_smooth"       default=" 15.0"/> <!-- Js: configuration change -->
<arg name="safety_clearance"    default=" 0.6"/>
<arg name="max_angle_step"      default=" 1"/>
	<arg name="check_transition"    default="false"/>
<arg name="transition_position_step" default="0.1"/>
<arg name="transition_angle_step_deg" default="3.0"/>
<arg name="enable_load_corridor" default="false"/>
<arg name="enforce_system_clearance" default="false"/>
<arg name="load_corridor_clearance" default="0.3"/>
<arg name="load_corridor_max_segment_length" default="2.4"/>
<arg name="load_corridor_min_segment_length" default="0.8"/>
<arg name="load_corridor_longitudinal_overlap" default="0.2"/>
<arg name="load_corridor_complexity_radius" default="1.2"/>
<arg name="load_corridor_clearance_weight" default="0.8"/>
<arg name="load_corridor_density_weight" default="3.0"/>
<arg name="load_corridor_min_extent" default="0.6"/>
<arg name="load_corridor_max_extent" default="2.0"/>
<arg name="load_corridor_extent_gain" default="1.5"/>
<arg name="load_corridor_payload_radius" default="0.05"/>
<arg name="load_corridor_cable_radius" default="0.02"/>
<arg name="load_corridor_drone_radius" default="0.125"/>
<arg name="load_corridor_bridge_safety_factor" default="0.6"/>
<arg name="load_corridor_min_overlap_radius" default="0.01"/>
<arg name="load_corridor_ellipsoid_transverse_scale" default="0.8"/>
<arg name="load_corridor_ellipsoid_max_longitudinal_radius" default="1.0"/>
<arg name="use_load_corridor_backend" default="false"/>
<arg name="corridor_parameterization_scale" default="0.95"/>
<arg name="corridor_temporal_groups" default="10"/>
<arg name="corridor_narrow_extent_threshold" default="0.7"/>
<arg name="corridor_narrow_margin_threshold" default="0.0"/>
<arg name="corridor_narrow_padding" default="0"/>
<arg name="corridor_terminal_guard_junctions" default="0"/>
<arg name="enable_corridor_path_smoothing" default="false"/>
<arg name="corridor_smoothing_iterations" default="8"/>
<arg name="corridor_smoothing_position_gain" default="0.45"/>
<arg name="corridor_smoothing_angle_gain" default="0.35"/>
<arg name="corridor_smoothing_max_deviation" default="0.6"/>
<arg name="corridor_smoothing_min_clearance" default="0.0"/>

<arg name="length"              default=" 1.5"/>

<!-- Shared frontend/backend cable-angle parameters, expressed as multiples of PI. -->
<arg name="common_max_theta_pi" default="0.3333333"/>
<arg name="common_min_theta_pi" default="0.0466667"/>
<!-- 39.36 deg is exactly the fourth A* angle bin for [8.4, 60] deg at resolution 10. -->
<arg name="boundary_theta_pi"   default="0.2186667"/>
<arg name="angle_resolution"    default=" 10"/>
<arg name="configuration_tracking_weight" default="5000.0"/>
<arg name="cable_drone_collision_weight" default="100.0"/>
<arg name="load_ground_penalty_scale" default="10000.0"/>
<arg name="load_visual_scale" default="0.3076923077"/>
<arg name="drone_visual_scale" default="0.2771088070"/>
<arg name="cable_theta_rate_weight" default="100.0"/>
<arg name="cable_psi_rate_weight" default="100.0"/>
<arg name="cable_theta_acc_weight" default="20.0"/>
<arg name="cable_psi_acc_weight" default="20.0"/>
<arg name="max_cable_theta_rate" default="0.60"/>
<arg name="max_cable_psi_rate" default="0.80"/>
<arg name="max_cable_theta_acc" default="2.00"/>
<arg name="max_cable_psi_acc" default="3.00"/>
<arg name="cable_rate_limit_weight" default="10000.0"/>
<arg name="cable_acc_limit_weight" default="10000.0"/>
<arg name="reject_cable_kinematic_violation" default="false"/>
<arg name="optimize_terminal_psi" default="false"/>
<arg name="cable_kinematic_log_path" default="/tmp/marts_cable_kinematics.csv"/>
<arg name="backend_integral_intervals" default="3"/>
<arg name="enable_clearance_hard_waypoints" default="false"/>
<arg name="hard_waypoint_clearance_threshold" default="0.8"/>
<arg name="hard_waypoint_log_path" default="/tmp/marts_hard_load_waypoints.csv"/>
<arg name="enable_drone_attitude_log" default="false"/>
<arg name="drone_attitude_log_path" default="/tmp/marts_drone_attitude.csv"/>

<arg name="wayPointSplitNum"    default=" 7"/>


  <node pkg="grid_path_searcher" type="astar_path_searcher" name="astar_path_searcher" output="screen" required = "true">
      <remap from="~waypoints"       to="/waypoint_generator/waypoints"/>
      <remap from="~map"             to="/complex_map/global_map"/>

      <param name="map/margin"                  value="0.2"                     />


      <param name="map/resolution"              value="0.4"                     />

      <param name="map/x_size"                  value="$(arg map_size_x)"       />
      <param name="map/y_size"                  value="$(arg map_size_y)"       />
      <param name="map/z_size"                  value="$(arg map_size_z)"       />

      <param name="map/isExp"                   value="$(arg isExp)"            />
      <param name="map/isReplanMode"            value="$(arg isReplanMode)"     />
      <param name="map/isNarrowSlitMode"        value="$(arg isNarrowSlitMode)" />
      <param name="map/time_ahead"              value="$(arg time_ahead)"       />

      <param name="search/x_max"                value="$(arg search_x_max)"     />
      <param name="search/x_min"                value="$(arg search_x_min)"     />
      <param name="search/y_max"                value="$(arg search_y_max)"     />
      <param name="search/y_min"                value="$(arg search_y_min)"     />
      <param name="search/z_max"                value="$(arg search_z_max)"     />
      <param name="search/z_min"                value="$(arg search_z_min)"     />
	  
      <param name="heuristic/distance"          value="$(arg distance)"         />
      <param name="weight/a"                    value="$(arg weight_a)"         />
      <param name="weight/b"                    value="$(arg weight_b)"         />
      <param name="weight/angle"                value="$(arg weight_angle)"     />
      <param name="weight/clearance"            value="$(arg weight_clearance)" />
      <param name="weight/smooth"               value="$(arg weight_smooth)"    />
      <param name="safety/clearance"            value="$(arg safety_clearance)" />
      <param name="configuration/max_angle_step" value="$(arg max_angle_step)"  />
	      <param name="configuration/check_transition" value="$(arg check_transition)" />
      <param name="configuration/transition_position_step" value="$(arg transition_position_step)" />
      <param name="configuration/transition_angle_step_deg" value="$(arg transition_angle_step_deg)" />
      <param name="corridor/enable" value="$(arg enable_load_corridor)" />
      <param name="safety/enforce_system_clearance" value="$(arg enforce_system_clearance)" />
      <param name="corridor/load_clearance" value="$(arg load_corridor_clearance)" />
      <param name="corridor/max_segment_length" value="$(arg load_corridor_max_segment_length)" />
      <param name="corridor/min_segment_length" value="$(arg load_corridor_min_segment_length)" />
      <param name="corridor/longitudinal_overlap" value="$(arg load_corridor_longitudinal_overlap)" />
      <param name="corridor/complexity_radius" value="$(arg load_corridor_complexity_radius)" />
      <param name="corridor/clearance_weight" value="$(arg load_corridor_clearance_weight)" />
      <param name="corridor/density_weight" value="$(arg load_corridor_density_weight)" />
      <param name="corridor/min_extent" value="$(arg load_corridor_min_extent)" />
      <param name="corridor/max_extent" value="$(arg load_corridor_max_extent)" />
      <param name="corridor/extent_gain" value="$(arg load_corridor_extent_gain)" />
      <param name="corridor/payload_radius" value="$(arg load_corridor_payload_radius)" />
      <param name="corridor/cable_radius" value="$(arg load_corridor_cable_radius)" />
      <param name="corridor/drone_radius" value="$(arg load_corridor_drone_radius)" />
      <param name="corridor/bridge_safety_factor" value="$(arg load_corridor_bridge_safety_factor)" />
      <param name="corridor/min_overlap_radius" value="$(arg load_corridor_min_overlap_radius)" />
      <param name="corridor/ellipsoid_transverse_scale" value="$(arg load_corridor_ellipsoid_transverse_scale)" />
      <param name="corridor/ellipsoid_max_longitudinal_radius" value="$(arg load_corridor_ellipsoid_max_longitudinal_radius)" />
      <param name="corridor/smoothing/enable" value="$(arg enable_corridor_path_smoothing)" />
      <param name="corridor/smoothing/iterations" value="$(arg corridor_smoothing_iterations)" />
      <param name="corridor/smoothing/position_gain" value="$(arg corridor_smoothing_position_gain)" />
      <param name="corridor/smoothing/angle_gain" value="$(arg corridor_smoothing_angle_gain)" />
      <param name="corridor/smoothing/max_deviation" value="$(arg corridor_smoothing_max_deviation)" />
      <param name="corridor/smoothing/min_clearance" value="$(arg corridor_smoothing_min_clearance)" />
      <!-- Keep the measured/initial angle at the start; the goal angle is selected by A*. -->
      <param name="configuration/enforce_boundary_angle" value="true" />
      <param name="configuration/boundary_angle_pi" value="$(arg boundary_theta_pi)" />
      <param name="weight/length"               value="$(arg length)"           />
      <param name="weight/max_angle"            value="$(arg common_max_theta_pi)" />
      <param name="weight/min_angle"            value="$(arg common_min_theta_pi)" />
      <param name="weight/angle_resolution"     value="$(arg angle_resolution)" />
      <param name="wayPts/wayPointSplitNum"     value="$(arg wayPointSplitNum)" />
  </node>

  <node pkg ="grid_path_searcher" name ="complex_map" type ="complex_map" output = "screen">      
      <param name="sensing/rate"            value="0.5"/>
      <param name="cloud_resolution"        value="$(arg cloud_resolution)"/>

      <param name="map_id"                  value="$(arg map_id)"/>
      <!-- map in file -->
      <param name="pcd_path"                value="$(arg pcd_path)"/>

  </node>

  <node pkg="grid_path_searcher" name="waypoint_generator" type="waypoint_generator" output="screen">
      <remap from="~goal" to="/goal"/>
      <param name="waypoint_type" value="manual-lonely-waypoint"/>    
  </node>

  <node pkg="gcopter" type="global_planning" name="global_planning_node" output="screen">
    <rosparam file="$(find gcopter)/config/Astar_planning_S.yaml" command="load" />
    <param name="MinTheta" value="$(arg common_min_theta_pi)"/>
    <param name="MaxTheta" value="$(arg common_max_theta_pi)"/>
    <rosparam param="InifinAngT" subst_value="true">
      [$(arg boundary_theta_pi), 0.0, 1.0]
    </rosparam>
    <param name="ConfigurationTrackingWeight" value="$(arg configuration_tracking_weight)"/>
    <param name="UseLoadCorridor" value="$(arg use_load_corridor_backend)"/>
    <param name="CorridorParameterizationScale" value="$(arg corridor_parameterization_scale)"/>
    <param name="CorridorTemporalGroups" value="$(arg corridor_temporal_groups)"/>
    <param name="CorridorNarrowExtentThreshold" value="$(arg corridor_narrow_extent_threshold)"/>
    <param name="CorridorNarrowMarginThreshold" value="$(arg corridor_narrow_margin_threshold)"/>
    <param name="CorridorNarrowPadding" value="$(arg corridor_narrow_padding)"/>
    <param name="CorridorTerminalGuardJunctions" value="$(arg corridor_terminal_guard_junctions)"/>
    <param name="CableDroneCollisionWeight" value="$(arg cable_drone_collision_weight)"/>
    <param name="LoadGroundPenaltyScale" value="$(arg load_ground_penalty_scale)"/>
    <param name="CableThetaRateWeight" value="$(arg cable_theta_rate_weight)"/>
    <param name="CablePsiRateWeight" value="$(arg cable_psi_rate_weight)"/>
    <param name="CableThetaAccWeight" value="$(arg cable_theta_acc_weight)"/>
    <param name="CablePsiAccWeight" value="$(arg cable_psi_acc_weight)"/>
    <param name="MaxCableThetaRate" value="$(arg max_cable_theta_rate)"/>
    <param name="MaxCablePsiRate" value="$(arg max_cable_psi_rate)"/>
    <param name="MaxCableThetaAcc" value="$(arg max_cable_theta_acc)"/>
    <param name="MaxCablePsiAcc" value="$(arg max_cable_psi_acc)"/>
    <param name="CableRateLimitWeight" value="$(arg cable_rate_limit_weight)"/>
    <param name="CableAccLimitWeight" value="$(arg cable_acc_limit_weight)"/>
    <param name="RejectCableKinematicViolation" value="$(arg reject_cable_kinematic_violation)"/>
    <param name="OptimizeTerminalPsi" value="$(arg optimize_terminal_psi)"/>
    <param name="CableKinematicLogPath" value="$(arg cable_kinematic_log_path)"/>
    <param name="IntegralIntervs" value="$(arg backend_integral_intervals)"/>
    <param name="EnableClearanceHardWaypoints" value="$(arg enable_clearance_hard_waypoints)"/>
    <param name="HardWaypointClearanceThreshold" value="$(arg hard_waypoint_clearance_threshold)"/>
    <param name="HardWaypointLogPath" value="$(arg hard_waypoint_log_path)"/>
    <param name="EnableDroneAttitudeLog" value="$(arg enable_drone_attitude_log)"/>
    <param name="DroneAttitudeLogPath" value="$(arg drone_attitude_log_path)"/>

    <remap from="~grid_map/cloud" to="/complex_map/global_map"/>
    <param name="grid_map/resolution"             value="0.1" /> 
    <param name="grid_map/map_size_x"             value="50.0" /> 
    <param name="grid_map/map_size_y"             value="40.0" /> 
    <param name="grid_map/map_size_z"             value="5.0" /> 
    <param name="grid_map/local_update_range_x"   value="50.0" /> 
    <param name="grid_map/local_update_range_y"   value="50.0" /> 
    <param name="grid_map/local_update_range_z"   value="5.0" /> 
    <param name="grid_map/obstacles_inflation"    value="0.1" /> 
    <param name="grid_map/local_map_margin"       value="10"/>
    <param name="grid_map/virtual_ceil_height"    value="3.0"/>            
    <param name="grid_map/ground_height"          value="-0.01"/>

    <!-- local fusion -->
    <param name="grid_map/p_min"  value="0.12"/>
    <param name="grid_map/p_max"  value="0.90"/>
    <param name="grid_map/p_occ"  value="0.80"/>
    <param name="grid_map/visualization_truncate_height"    value="2.8"/>
    <param name="grid_map/pose_type"                        value="1"/>  
    <param name="grid_map/frame_id"                         value="odom"/>

    <!-- sdf map -->
    <param name="grid_map/local_bound_inflate"   value="0.1"/>                  
    <param name="grid_map/show_esdf_time"                  value="false"/>      
    <param name="grid_map/esdf_slice_height"               value="0.3"/>         

  </node>

  <include file="$(find gcopter)/launch/odom_visual.launch">
      <arg name="drone_id"      value="0"/>
      <arg name="isQuadrotor"   value="false"/>
      <arg name="robot_scale"   value="$(arg load_visual_scale)"/>
      <arg name="odom_topic"    value="$(arg odom_topic)"/>

      <arg name="traj_scale_x"  value="0.02"/>
      <arg name="traj_scale_y"  value="0.0"/>
      <arg name="traj_scale_z"  value="0.0"/>

      <arg name="traj_color_r"  value="1.0"/>
      <arg name="traj_color_g"  value="0.0"/>
      <arg name="traj_color_b"  value="0.0"/>
      <arg name="traj_color_a"  value="0.6"/>

      <arg name="color_r"  value="255.0"/>
      <arg name="color_g"  value="255.0"/>
      <arg name="color_b"  value="255.0"/>
      <arg name="color_a"  value="1.0"/>

  </include>
  
  <include file="$(find gcopter)/launch/odom_visual.launch">
      <arg name="drone_id"      value="1"/>
      <arg name="isQuadrotor"   value="true"/>
      <arg name="robot_scale"   value="$(arg drone_visual_scale)"/>
      <arg name="odom_topic"    value="$(arg odom_topic)"/>

      <arg name="traj_scale_x"  value="0.02"/>
      <arg name="traj_scale_y"  value="0.0"/>
      <arg name="traj_scale_z"  value="0.0"/>

      <arg name="traj_color_r"  value="1.0"/>
      <arg name="traj_color_g"  value="0.0"/>
      <arg name="traj_color_b"  value="0.0"/>
      <arg name="traj_color_a"  value="0.6"/>

      <arg name="color_r"  value="237.0"/>
      <arg name="color_g"  value="90.0"/>
      <arg name="color_b"  value="101.0"/>
      <arg name="color_a"  value="1.0"/>
      

  </include>

  <include file="$(find gcopter)/launch/odom_visual.launch">
      <arg name="drone_id"      value="2"/>
      <arg name="isQuadrotor"   value="true"/>
      <arg name="robot_scale"   value="$(arg drone_visual_scale)"/>
      <arg name="odom_topic"    value="$(arg odom_topic)"/>

      <arg name="traj_scale_x"  value="0.02"/>
      <arg name="traj_scale_y"  value="0.0"/>
      <arg name="traj_scale_z"  value="0.0"/>

      <arg name="traj_color_r"  value="1.0"/>
      <arg name="traj_color_g"  value="0.0"/>
      <arg name="traj_color_b"  value="0.0"/>
      <arg name="traj_color_a"  value="0.6"/>

      <arg name="color_r"  value="237.0"/>
      <arg name="color_g"  value="90.0"/>
      <arg name="color_b"  value="101.0"/>
      <arg name="color_a"  value="1.0"/>

  </include>

  <include file="$(find gcopter)/launch/odom_visual.launch">
      <arg name="drone_id"      value="3"/>
      <arg name="isQuadrotor"   value="true"/>
      <arg name="robot_scale"   value="$(arg drone_visual_scale)"/>
      <arg name="odom_topic"    value="$(arg odom_topic)"/>

      <arg name="traj_scale_x"  value="0.02"/>
      <arg name="traj_scale_y"  value="0.0"/>
      <arg name="traj_scale_z"  value="0.0"/>

      <arg name="traj_color_r"  value="1.0"/>
      <arg name="traj_color_g"  value="0.0"/>
      <arg name="traj_color_b"  value="0.0"/>
      <arg name="traj_color_a"  value="0.6"/>

      <arg name="color_r"  value="237.0"/>
      <arg name="color_g"  value="90.0"/>
      <arg name="color_b"  value="101.0"/>
      <arg name="color_a"  value="1.0"/>

  </include>

  <include file="$(find gcopter)/launch/odom_visual.launch">
      <arg name="drone_id"      value="4"/>
      <arg name="isQuadrotor"   value="true"/>
      <arg name="robot_scale"   value="$(arg drone_visual_scale)"/>
      <arg name="odom_topic"    value="$(arg odom_topic)"/>

      <arg name="traj_scale_x"  value="0.02"/>
      <arg name="traj_scale_y"  value="0.0"/>
      <arg name="traj_scale_z"  value="0.0"/>

      <arg name="traj_color_r"  value="1.0"/>
      <arg name="traj_color_g"  value="0.0"/>
      <arg name="traj_color_b"  value="0.0"/>
      <arg name="traj_color_a"  value="0.6"/>

      <arg name="color_r"  value="237.0"/>
      <arg name="color_g"  value="90.0"/>
      <arg name="color_b"  value="101.0"/>
      <arg name="color_a"  value="1.0"/>

  </include>

  <include file="$(find gcopter)/launch/odom_visual.launch">
      <arg name="drone_id"      value="5"/>
      <arg name="isQuadrotor"   value="true"/>
      <arg name="robot_scale"   value="$(arg drone_visual_scale)"/>
      <arg name="odom_topic"    value="$(arg odom_topic)"/>

      <arg name="traj_scale_x"  value="0.02"/>
      <arg name="traj_scale_y"  value="0.0"/>
      <arg name="traj_scale_z"  value="0.0"/>

      <arg name="traj_color_r"  value="1.0"/>
      <arg name="traj_color_g"  value="0.0"/>
      <arg name="traj_color_b"  value="0.0"/>
      <arg name="traj_color_a"  value="0.6"/>

      <arg name="color_r"  value="237.0"/>
      <arg name="color_g"  value="90.0"/>
      <arg name="color_b"  value="101.0"/>
      <arg name="color_a"  value="1.0"/>

  </include>

  <include file="$(find gcopter)/launch/odom_visual.launch">
      <arg name="drone_id"      value="6"/>
      <arg name="isQuadrotor"   value="true"/>
      <arg name="robot_scale"   value="$(arg drone_visual_scale)"/>
      <arg name="odom_topic"    value="$(arg odom_topic)"/>

      <arg name="traj_scale_x"  value="0.02"/>
      <arg name="traj_scale_y"  value="0.0"/>
      <arg name="traj_scale_z"  value="0.0"/>

      <arg name="traj_color_r"  value="1.0"/>
      <arg name="traj_color_g"  value="0.0"/>
      <arg name="traj_color_b"  value="0.0"/>
      <arg name="traj_color_a"  value="0.6"/>

      <arg name="color_r"  value="237.0"/>
      <arg name="color_g"  value="90.0"/>
      <arg name="color_b"  value="101.0"/>
      <arg name="color_a"  value="1.0"/>

  </include>

</launch>
